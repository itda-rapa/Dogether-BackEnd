DB_URL=jdbc:postgresql://localhost:5432/dogether
DB_USERNAME=postgres
DB_PASSWORD=change-me
POSTGRES_PORT=5432
FLYWAY_ENABLED=false
#임시로 flyway 비활성화. 추후 배포 및 통합 테스트시 활성화

SPRING_PROFILES_ACTIVE=local
APP_PORT=8080

# Kafka connection used by the RiskSignal Outbox Relay.
KAFKA_BOOTSTRAP_SERVER=localhost:9092

# RiskSignal Outbox Relay is disabled by default. Enable it only after Kafka
# connectivity and the risk-signal-topic consumer idempotency are verified.
RISK_SIGNAL_OUTBOX_RELAY_ENABLED=false
RISK_SIGNAL_OUTBOX_RELAY_DELAY_MS=1000
RISK_SIGNAL_OUTBOX_RELAY_BATCH_SIZE=50
RISK_SIGNAL_OUTBOX_RELAY_LEASE=1m
RISK_SIGNAL_OUTBOX_RELAY_SEND_TIMEOUT=10s
RISK_SIGNAL_OUTBOX_RELAY_MAX_BLOCK=5s
RISK_SIGNAL_OUTBOX_RELAY_MAX_ATTEMPTS=10
RISK_SIGNAL_OUTBOX_RELAY_BASE_BACKOFF=5s
RISK_SIGNAL_OUTBOX_RELAY_MAX_BACKOFF=10m

# RiskSignal Consumer. Create both risk-signal-topic and risk-signal-topic.DLT
# with production replication/ACL/retention before enabling it.
RISK_SIGNAL_CONSUMER_ENABLED=false
RISK_SIGNAL_CONSUMER_GROUP_ID=dogether-risk-signal-v1
RISK_SIGNAL_CONSUMER_CONCURRENCY=1
RISK_SIGNAL_CONSUMER_MAX_POLL_RECORDS=100
RISK_SIGNAL_CONSUMER_MAX_ATTEMPTS=3
RISK_SIGNAL_CONSUMER_RETRY_BACKOFF=1s
RISK_SIGNAL_CONSUMER_DLT_TOPIC=risk-signal-topic.DLT
RISK_SIGNAL_CONSUMER_DLT_PUBLISH_TIMEOUT=10s
RISK_SIGNAL_MAX_FUTURE_SKEW=5m
RISK_SIGNAL_MAX_AGGREGATION_RANGE=90d

JWT_ISSUER=dogether
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

CORS_ALLOWED_ORIGINS=http://localhost:3000

# 기본값은 비활성이다. prod에서 true로 설정할 때는 SimpleBroker의 단일 replica 배포를 보장한다.
WEBSOCKET_ENABLED=false

RUSTFS_IMAGE=rustfs/rustfs:팀에서-확정한-버전
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_SESSION_TOKEN=

S3_BUCKET=dogether-local
S3_ENDPOINT=http://localhost:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_PATH_STYLE=true
S3_ALLOW_INSECURE_ENDPOINT=true
# Local compatibility default. Production profile always requires a Version ID.
SETLOG_UPLOAD_REQUIRE_VERSION_ID=false

MEDIA_UPLOAD_URL_TTL=15m
MEDIA_VIEW_URL_TTL=10m
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAINTENANCE_DELAY=1m

# Setlog orphan/deleted object cleanup. The ingress/LB/S3 client must terminate
# an upload request within MAX_UPLOAD_DURATION; SETTLE_GRACE must be at least as long.
STORAGE_CLEANUP_ENABLED=true
STORAGE_CLEANUP_DELAY_MS=60000
STORAGE_CLEANUP_BATCH_SIZE=50
STORAGE_CLEANUP_LEASE=5m
STORAGE_CLEANUP_MAX_ATTEMPTS=10
STORAGE_CLEANUP_MAX_UPLOAD_DURATION=20m
STORAGE_CLEANUP_UPLOAD_SETTLE_GRACE=30m
STORAGE_CLEANUP_BASE_BACKOFF=30s
STORAGE_CLEANUP_MAX_BACKOFF=6h

INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NICKNAME=
INITIAL_ADMIN_NEIGHBORHOOD_CODE=

# Swagger is enabled by default outside the prod profile.
SWAGGER_ENABLED=true

CHAT_ROOM_LIFECYCLE_ENABLED=true
CHAT_ROOM_LIFECYCLE_MAINTENANCE_DELAY_MS=60000
CHAT_ROOM_LIFECYCLE_BATCH_SIZE=100
CHAT_ROOM_LIFECYCLE_ARCHIVE_AFTER_DAYS=30

# Redis is started from deployment/local/docker-compose.yml for IDE/Gradle runs.
REDIS_HOST=localhost
REDIS_PORT=6379

# Email verification worker is intentionally off by default. Enable it only after local Redis is running.
EMAIL_VERIFICATION_HMAC_SECRET=replace-with-a-random-email-hmac-secret-at-least-32-bytes
EMAIL_VERIFICATION_CHALLENGE_TTL=5m
EMAIL_VERIFICATION_TOKEN_TTL=15m
EMAIL_VERIFICATION_COOLDOWN=60s
EMAIL_VERIFICATION_PAYLOAD_TTL=5m
EMAIL_VERIFICATION_WORKER_ENABLED=false
EMAIL_VERIFICATION_SENDER_MODE=fake
EMAIL_STREAM_KEY=dogether:email:v1:delivery:stream
EMAIL_STREAM_GROUP=email-delivery
EMAIL_STREAM_CONSUMER=email-worker-1
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Required for Pet registration verification. Do not share the email verification secret.
PET_VERIFICATION_HMAC_SECRET=replace-with-a-random-pet-verification-hmac-secret-at-least-32-bytes
# PET_VERIFICATION_SERVICE_KEY expects the decoded public-data decoding key; the app encodes it once for the query.
PET_VERIFICATION_SERVICE_KEY=
PET_VERIFICATION_TOKEN_TTL=15m
PET_VERIFICATION_CONNECT_TIMEOUT=3s
PET_VERIFICATION_READ_TIMEOUT=5s

# Configure only for manual SMTP QA. Do not commit real credentials.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
