DB_URL=jdbc:postgresql://localhost:5432/dogether
DB_USERNAME=postgres
DB_PASSWORD=change-me
POSTGRES_PORT=5432
FLYWAY_ENABLED=true
# 운영은 Flyway 적용 후 Hibernate validate를 사용한다. Risk V37 → Safety Queue V38 순서를 확인한다.

SPRING_PROFILES_ACTIVE=local
APP_PORT=8080

# Kafka connection used by the RiskSignal Outbox Relay.
KAFKA_BOOTSTRAP_SERVER=localhost:9092

# RiskSignal Outbox Relay is disabled by default. Enable it only after Kafka
# connectivity and the risk-signal-topic consumer idempotency are verified.
RISK_SIGNAL_OUTBOX_RELAY_ENABLED=false
RISK_SIGNAL_OUTBOX_RELAY_DELAY_MS=1000
RISK_SIGNAL_OUTBOX_RELAY_BATCH_SIZE=50
RISK_SIGNAL_OUTBOX_RELAY_LEASE=1m
RISK_SIGNAL_OUTBOX_RELAY_SEND_TIMEOUT=10s
RISK_SIGNAL_OUTBOX_RELAY_MAX_BLOCK=5s
RISK_SIGNAL_OUTBOX_RELAY_MAX_ATTEMPTS=10
RISK_SIGNAL_OUTBOX_RELAY_BASE_BACKOFF=5s
RISK_SIGNAL_OUTBOX_RELAY_MAX_BACKOFF=10m

# RiskSignal Consumer. Create both risk-signal-topic and risk-signal-topic.DLT
# with production replication/ACL/retention before enabling it.
RISK_SIGNAL_CONSUMER_ENABLED=false
RISK_SIGNAL_CONSUMER_GROUP_ID=dogether-risk-signal-v1
RISK_SIGNAL_CONSUMER_CONCURRENCY=1
RISK_SIGNAL_CONSUMER_MAX_POLL_RECORDS=100
RISK_SIGNAL_CONSUMER_MAX_ATTEMPTS=3
RISK_SIGNAL_CONSUMER_RETRY_BACKOFF=1s
RISK_SIGNAL_CONSUMER_DLT_TOPIC=risk-signal-topic.DLT
RISK_SIGNAL_CONSUMER_DLT_PUBLISH_TIMEOUT=10s
RISK_SIGNAL_MAX_FUTURE_SKEW=5m
RISK_SIGNAL_MAX_AGGREGATION_RANGE=90d

JWT_ISSUER=dogether
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# Google/Naver OIDC is disabled unless explicitly enabled. Client-provided redirect URLs are never used:
# register the backend redirect URI with each provider and allowlist the exact frontend callback URLs here.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
GOOGLE_OAUTH_SUCCESS_CALLBACK_URI=http://localhost:3000/oauth/success
GOOGLE_OAUTH_ERROR_CALLBACK_URI=http://localhost:3000/oauth/error
GOOGLE_OAUTH_ALLOWED_CALLBACK_URLS=http://localhost:3000/oauth/success,http://localhost:3000/oauth/error
GOOGLE_OAUTH_TRANSACTION_TTL=5m
GOOGLE_OAUTH_TRANSACTION_GRACE_TTL=1m
GOOGLE_OAUTH_CONNECT_TIMEOUT=3s
GOOGLE_OAUTH_READ_TIMEOUT=5s
NAVER_OAUTH_ENABLED=false
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/naver
NAVER_OAUTH_SUCCESS_CALLBACK_URI=http://localhost:3000/oauth/success
NAVER_OAUTH_ERROR_CALLBACK_URI=http://localhost:3000/oauth/error
NAVER_OAUTH_ALLOWED_CALLBACK_URLS=http://localhost:3000/oauth/success,http://localhost:3000/oauth/error
# Naver OIDC endpoints (issuer, authorization/token/JWKS, and userinfo) are fixed by the server integration.
NAVER_OAUTH_TRANSACTION_TTL=5m
NAVER_OAUTH_TRANSACTION_GRACE_TTL=1m
NAVER_OAUTH_CONNECT_TIMEOUT=3s
NAVER_OAUTH_READ_TIMEOUT=5s

CORS_ALLOWED_ORIGINS=http://localhost:3000

# 기본값은 비활성이다. prod에서 true로 설정할 때는 SimpleBroker의 단일 replica 배포를 보장한다.
WEBSOCKET_ENABLED=false

# Location validates malformed/stale captures. Accuracy at or above the threshold
# remains a valid value and is handed to Meeting as a confirmation-code fallback signal.
LOCATION_MAX_CAPTURE_AGE=5m
LOCATION_FUTURE_TOLERANCE=30s
LOCATION_QUALITY_THRESHOLD_METERS=50

# Meeting verification GPS policy. submission-interval compares the server receive
# time (submittedAt) of both sides, not the device capture time.
MEETING_VERIFICATION_DISTANCE_LIMIT_METERS=100
MEETING_VERIFICATION_SUBMISSION_INTERVAL=5m
MEETING_VERIFICATION_MEETING_TIME_WINDOW=1h
# Required in production. HMAC secret for the request-idempotency ledger fingerprint.
# Must be at least 32 bytes when encoded as UTF-8 (startup fail-fast, byte-based).
# The example placeholder below is also rejected at startup: replace it with a real
# random secret before running. Idempotency replay is guaranteed while the SAME HMAC
# key is kept; rotating the key invalidates old fingerprints. Do not reuse the
# email/pet verification secrets.
MEETING_VERIFICATION_HMAC_SECRET=replace-with-a-random-meeting-verification-hmac-secret-at-least-32-bytes
# SUBMITTED expiry worker scrubs raw GPS after meetAt + meeting-time-window.
# Default is true: raw GPS retention is opt-out, not opt-in. Disabling it in prod leaves
# expired SUBMITTED raw coordinates stored indefinitely — an explicit decision is required.
MEETING_VERIFICATION_EXPIRY_ENABLED=true
MEETING_VERIFICATION_EXPIRY_DELAY=60s
MEETING_VERIFICATION_EXPIRY_BATCH_SIZE=50

RUSTFS_IMAGE=rustfs/rustfs:팀에서-확정한-버전
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_SESSION_TOKEN=

S3_BUCKET=dogether-local
S3_ENDPOINT=http://localhost:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_PATH_STYLE=true
S3_ALLOW_INSECURE_ENDPOINT=true
# Local compatibility default. Production profile always requires a Version ID.
SETLOG_UPLOAD_REQUIRE_VERSION_ID=false

MEDIA_UPLOAD_URL_TTL=15m
MEDIA_VIEW_URL_TTL=10m
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAINTENANCE_DELAY=1m

# Setlog orphan/deleted object cleanup. The ingress/LB/S3 client must terminate
# an upload request within MAX_UPLOAD_DURATION; SETTLE_GRACE must be at least as long.
STORAGE_CLEANUP_ENABLED=true
STORAGE_CLEANUP_DELAY_MS=60000
STORAGE_CLEANUP_BATCH_SIZE=50
STORAGE_CLEANUP_LEASE=5m
STORAGE_CLEANUP_MAX_ATTEMPTS=10
STORAGE_CLEANUP_MAX_UPLOAD_DURATION=20m
STORAGE_CLEANUP_UPLOAD_SETTLE_GRACE=30m
STORAGE_CLEANUP_BASE_BACKOFF=30s
STORAGE_CLEANUP_MAX_BACKOFF=6h

# Safety evaluation is disabled until an explicit, versioned policy is configured.
SAFETY_EVALUATOR_ENABLED=false
SAFETY_EVALUATOR_THRESHOLD=
SAFETY_EVALUATOR_WINDOW=
SAFETY_EVALUATOR_POLICY_VERSION=
SAFETY_EVALUATOR_BATCH_SIZE=50
SAFETY_EVALUATOR_DELAY_MS=5000
SAFETY_EVALUATOR_LEASE=1m
SAFETY_EVALUATOR_MAX_ATTEMPTS=10
SAFETY_EVALUATOR_BASE_BACKOFF=5s
SAFETY_EVALUATOR_MAX_BACKOFF=10m

INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NICKNAME=
INITIAL_ADMIN_NEIGHBORHOOD_CODE=

# Swagger is enabled by default outside the prod profile.
SWAGGER_ENABLED=true

CHAT_ROOM_LIFECYCLE_ENABLED=true
CHAT_ROOM_LIFECYCLE_MAINTENANCE_DELAY_MS=60000
CHAT_ROOM_LIFECYCLE_BATCH_SIZE=100
CHAT_ROOM_LIFECYCLE_ARCHIVE_AFTER_DAYS=30

# Redis is started from deployment/local/docker-compose.yml for IDE/Gradle runs.
REDIS_HOST=localhost
REDIS_PORT=6379

# Email verification worker is intentionally off by default. Enable it only after local Redis is running.
EMAIL_VERIFICATION_HMAC_SECRET=replace-with-a-random-email-hmac-secret-at-least-32-bytes
EMAIL_VERIFICATION_CHALLENGE_TTL=5m
EMAIL_VERIFICATION_TOKEN_TTL=15m
EMAIL_VERIFICATION_COOLDOWN=60s
EMAIL_VERIFICATION_PAYLOAD_TTL=5m
EMAIL_VERIFICATION_WORKER_ENABLED=false
EMAIL_VERIFICATION_SENDER_MODE=fake
EMAIL_STREAM_KEY=dogether:email:v1:delivery:stream
EMAIL_STREAM_GROUP=email-delivery
EMAIL_STREAM_CONSUMER=email-worker-1
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Required for Pet registration verification. Do not share the email verification secret.
PET_VERIFICATION_HMAC_SECRET=replace-with-a-random-pet-verification-hmac-secret-at-least-32-bytes
# PET_VERIFICATION_SERVICE_KEY expects the decoded public-data decoding key; the app encodes it once for the query.
PET_VERIFICATION_SERVICE_KEY=
PET_VERIFICATION_TOKEN_TTL=15m
PET_VERIFICATION_CONNECT_TIMEOUT=3s
PET_VERIFICATION_READ_TIMEOUT=5s

# Configure only for manual SMTP QA. Do not commit real credentials.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Morning direct-conversation meeting suggestion scheduler (issue #142).
# Enabled=false by default: zone/cron/lease startup checks are skipped while disabled.
# When enabled, the schedule is FIXED to daily 07:00 Asia/Seoul (product contract):
# - MEETING_SUGGESTION_ZONE must be Asia/Seoul
# - the AI zone (app.meeting-card.ai.zone) must be Asia/Seoul
# - MEETING_SUGGESTION_SCHEDULER_CRON must be exactly "0 0 7 * * *"
# - MEETING_SUGGESTION_LEASE must be strictly longer than 2 x AI_TIMEOUT
#   (conservative connect+read HTTP budget)
MEETING_SUGGESTION_ENABLED=false
MEETING_SUGGESTION_ZONE=Asia/Seoul
MEETING_SUGGESTION_SCHEDULER_CRON=0 0 7 * * *
MEETING_SUGGESTION_RETRY_DELAY_MS=60000
MEETING_SUGGESTION_BATCH_SIZE=10
MEETING_SUGGESTION_LEASE=1m
MEETING_SUGGESTION_MAX_ATTEMPTS=10
MEETING_SUGGESTION_BASE_BACKOFF=5s
MEETING_SUGGESTION_MAX_BACKOFF=10m
