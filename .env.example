DB_URL=jdbc:postgresql://localhost:5432/dogether
DB_USERNAME=postgres
DB_PASSWORD=change-me
POSTGRES_PORT=5432
FLYWAY_ENABLED=false
#임시로 flyway 비활성화. 추후 배포 및 통합 테스트시 활성화

SPRING_PROFILES_ACTIVE=local
APP_PORT=8080

JWT_ISSUER=dogether
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

CORS_ALLOWED_ORIGINS=http://localhost:3000

RUSTFS_IMAGE=rustfs/rustfs:팀에서-확정한-버전
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_SESSION_TOKEN=

S3_BUCKET=dogether-local
S3_ENDPOINT=http://localhost:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_PATH_STYLE=true

MEDIA_UPLOAD_URL_TTL=15m
MEDIA_VIEW_URL_TTL=10m
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_MAINTENANCE_DELAY=1m

INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NICKNAME=
INITIAL_ADMIN_NEIGHBORHOOD_CODE=

# Swagger is enabled by default outside the prod profile.
SWAGGER_ENABLED=true
